{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "homelab": {
      "type": "remote",
      "url": "https://litellm.erwanleboucher.dev/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:LITELLM_API_KEY}",
        "x-litellm-api-key": "Bearer {env:LITELLM_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "@playwright/mcp@latest", "--browser=chromium"]
    },
    "open-design": {
      "type": "local",
      "command": [
        "/home/erwanleboucher/.local/share/nvm/v24.14.1/bin/node",
        "/home/erwanleboucher/dev/open-design/apps/daemon/dist/cli.js",
        "mcp"
      ],
      "enabled": true,
      "environment": {
        "OD_DATA_DIR": "/home/erwanleboucher/dev/open-design/.od",
        "OD_SIDECAR_IPC_PATH": "/tmp/open-design/ipc/default/daemon.sock"
      }
    }
  },
  "lsp": true,
  "formatter": true,
  "permission": {
    "external_directory": {
      "~/dev/**": "allow"
    }
  },
  "plugin": ["@eleboucher/opencode-memini", "oh-my-opencode-slim"],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "env": ["LITELLM_API_KEY"],
      "options": {
        "baseURL": "https://litellm.erwanleboucher.dev/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "zai-org/glm-5.2": {
          "name": "zai-org/glm-5.2",
          "limit": { "context": 1048560, "output": 131072 },
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "moonshotai/kimi-k2.6": {
          "name": "moonshotai/kimi-k2.6",
          "limit": { "context": 262128, "output": 131072 },
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "minimaxai/minimax-m3": {
          "name": "minimaxai/minimax-m3",
          "limit": { "context": 1000000, "output": 131072 },
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "opencode-go/kimi-k2.7-code": {
          "name": "opencode-go/kimi-k2.7-code",
          "limit": { "context": 262128, "output": 131072 },
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "opencode-go/kimi-k2.6": {
          "name": "opencode-go/kimi-k2.6",
          "limit": { "context": 262128, "output": 131072 },
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "opencode-go/deepseek-v4-flash": {
          "name": "opencode-go/deepseek-v4-flash",
          "limit": { "context": 131072, "output": 65536 },
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "opencode-go/mimo-v2.5": {
          "name": "opencode-go/mimo-v2.5",
          "limit": { "context": 262144, "output": 32768 },
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "opencode-go/qwen3.7-max": {
          "name": "opencode-go/qwen3.7-max",
