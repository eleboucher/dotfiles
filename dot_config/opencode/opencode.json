{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "homelab": {
      "type": "remote",
      "url": "https://litellm.erwanleboucher.dev/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:LITELLM_API_KEY}",
        "x-litellm-api-key": "Bearer {env:LITELLM_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "@playwright/mcp@latest", "--browser=chromium"]
    },
    "open-design": {
      "type": "local",
      "command": [
        "/home/erwanleboucher/.local/share/nvm/v24.14.1/bin/node",
        "/home/erwanleboucher/dev/open-design/apps/daemon/dist/cli.js",
        "mcp"
      ],
      "enabled": true,
      "environment": {
        "OD_DATA_DIR": "/home/erwanleboucher/dev/open-design/.od",
        "OD_SIDECAR_IPC_PATH": "/tmp/open-design/ipc/default/daemon.sock"
      }
    }
  },
  "lsp": true,
  "formatter": true,
  "permission": {
    "external_directory": {
      "~/dev/**": "allow"
    }
  },
  "plugin": ["@eleboucher/opencode-memini", "oh-my-opencode-slim"],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "env": ["LITELLM_API_KEY"],
      "options": {
        "baseURL": "https://litellm.erwanleboucher.dev/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "MiniMax-M3": {
          "name": "MiniMax-M3",
          "limit": { "context": 1000000, "output": 131072 },
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "limit": { "context": 1000000, "output": 131072 },
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "glm-5-turbo": {
          "name": "glm-5-turbo",
          "limit": { "context": 200000, "output": 16384 },
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "neuralwatt/glm-5.2": {
          "name": "neuralwatt/glm-5.2",
          "limit": { "context": 1048560, "output": 131072 },
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "neuralwatt/glm-5.2-fast": {
          "name": "neuralwatt/glm-5.2-fast",
          "limit": { "context": 1048560, "output": 131072 },
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "neuralwatt/glm-5.2-short": {
          "name": "neuralwatt/glm-5.2-short",
          "limit": { "context": 199984, "output": 131072 },
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "neuralwatt/glm-5.2-short-fast": {
          "name": "neuralwatt/glm-5.2-short-fast",
          "limit": { "context": 199984, "output": 131072 },
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "neuralwatt/kimi-k2.6": {
