# SwayFX config. Modules live in config.d/ and are loaded in the order below.

set $mod Mod4

### Monitor layout (DP-1 left, DP-2 right)
output DP-1 position 0 0 scale 1
output DP-2 position 2560 0 scale 1

### Workspaces pinned to monitors (1-5 on DP-1, 6-10 on DP-2)
workspace 1 output DP-1
workspace 2 output DP-1
workspace 3 output DP-1
workspace 4 output DP-1
workspace 5 output DP-1
workspace 6 output DP-2
workspace 7 output DP-2
workspace 8 output DP-2
workspace 9 output DP-2
workspace 10 output DP-2

### Load the rest: input/cursor, misc, appearance, autostart, rules, keybinds
include ~/.config/sway/config.d/input.conf
include ~/.config/sway/config.d/misc.conf
include ~/.config/sway/config.d/appearance.conf
include ~/.config/sway/config.d/execs.conf
include ~/.config/sway/config.d/rules.conf
include ~/.config/sway/config.d/binds.conf

# Noctalia theme (client.* colors). Noctalia generates ~/.config/sway/noctalia
# and its apply.sh greps this file for an `include .*noctalia` line, so keeping
# it here stops it appending a duplicate and putting this file out of sync with
# chezmoi. Must come last so the generated colors win.
include ~/.config/sway/noctalia
