# SwayFX config. Modules live in config.d/ and are loaded in the order below.

set $mod Mod4

### Monitors
# Identified by `make model serial`, not by connector name. Both panels are the
# same LG UltraGear model, so DP-1/DP-2 say nothing about which is which and a
# swapped cable or port would silently move every workspace below to the wrong
# screen. The serial cannot swap. `swaymsg -t get_outputs` prints these fields.
set $left  "LG Electronics LG ULTRAGEAR 409NTQDCQ356"
set $right "LG Electronics LG ULTRAGEAR 409NTCZCQ355"

output $left  position 0 0 scale 1
output $right position 2560 0 scale 1

### Workspaces pinned to monitors (1-5 left, 6-10 right)
# scripts/ws-range.sh parses these lines, resolving $left/$right against the
# live outputs, so the mapping stays defined in exactly one place.
workspace 1 output $left
workspace 2 output $left
workspace 3 output $left
workspace 4 output $left
workspace 5 output $left
workspace 6 output $right
workspace 7 output $right
workspace 8 output $right
workspace 9 output $right
workspace 10 output $right

### Load the rest: input/cursor, misc, appearance, autostart, rules, keybinds
include ~/.config/sway/config.d/input.conf
include ~/.config/sway/config.d/misc.conf
include ~/.config/sway/config.d/appearance.conf
include ~/.config/sway/config.d/execs.conf
include ~/.config/sway/config.d/rules.conf
include ~/.config/sway/config.d/binds.conf

# Noctalia theme (client.* colors). Noctalia generates ~/.config/sway/noctalia
# and its apply.sh greps this file for an `include .*noctalia` line, so keeping
# it here stops it appending a duplicate and putting this file out of sync with
# chezmoi. Must come last so the generated colors win.
include ~/.config/sway/noctalia
