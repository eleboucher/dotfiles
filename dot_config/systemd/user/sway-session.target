[Unit]
Description=sway compositor session
Documentation=man:systemd.special(7)
# graphical-session.target sets RefuseManualStart, so it can only be pulled in
# as a dependency - `systemctl --user start graphical-session.target` is
# refused. BindsTo gets it started (and stopped) along with this target, which
# is what uwsm does for us in a uwsm session; this target covers the plain
# sway.desktop session so units like gammastep.service still start there.
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
